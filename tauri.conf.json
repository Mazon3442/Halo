{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halo",
  "version": "0.1.0",
  "identifier": "com.mazon.halo",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "Local video background effects and captions",
    "longDescription": "Blur, remove or replace the background of a video, and caption it. Runs matting and speech models on your own GPU.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "models/rvm_mobilenetv3_fp32.onnx": "models/rvm_mobilenetv3_fp32.onnx",
      "target/release/DirectML.dll": "DirectML.dll",
      "ffmpeg/ffmpeg.exe": "ffmpeg.exe",
      "ffmpeg/ffprobe.exe": "ffprobe.exe",
      "web/": "web/"
    }
  }
}
